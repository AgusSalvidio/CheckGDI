# Copy this file to .env and adjust values as needed.

# Processes to monitor: comma-separated names (partial match, case-insensitive)
# Example with multiple: PROCESS_NAMES=abt,hyperspace,bell
PROCESS_NAMES=abt

# Polling interval in seconds
POLL_INTERVAL=10

# GDI thresholds for traffic-light coloring
#   < WARN                → green
#   WARN  <= x < CRITICAL → yellow
#   >= CRITICAL           → red
GDI_WARN_THRESHOLD=100
GDI_CRITICAL_THRESHOLD=300

# Windows GDI object limit per process (used for the progress bar scale)
GDI_MAX=10000

# Desktop notifications when count reaches GDI_CRITICAL_THRESHOLD
NOTIFICATION_ENABLED=true
# Minimum seconds between notifications for the same PID (prevents spam)
NOTIFICATION_COOLDOWN=60

# Display options
SHOW_BAR=true
SHOW_PERCENTAGE=true

# View style: "bars" (default progress bar) or "gauge" (automotive RPM-style dial, GDI in thousands)
VIEW_STYLE=bars
# Gauge design (only applies when VIEW_STYLE=gauge): "classic" (chrome analog), "retro" (ivory analog)
# or "digital" (LCD progress ring, no needle)
GAUGE_STYLE=classic
# Needle style for the analog gauge designs (classic/retro): "classic" (dagger+tail), "sport" (two-tone
# racing blade), "twin" (double-rail pointer) or "line" (minimalist dot-tipped line)
NEEDLE_STYLE=classic
# Needle color override: "auto" (style default) or a hex color like "#ff6600"
NEEDLE_COLOR=auto
# Tick/zone coloring: "multicolor" (yellow past GDI_WARN_THRESHOLD, red past GDI_CRITICAL_THRESHOLD)
# or "mono" (all ticks take GAUGE_ACCENT_COLOR, single-tone look, independent of thresholds)
GAUGE_ZONE_MODE=multicolor
# Accent color used by GAUGE_ZONE_MODE=mono for every tick (independent of NEEDLE_COLOR):
# "auto" (defaults to the resolved needle color) or a hex color like "#ff6600"
GAUGE_ACCENT_COLOR=auto
# Tick number / digit color override: "auto" (style default) or a hex color like "#ffffff"
GAUGE_NUMBER_COLOR=auto
# Dial/face background color override: "auto" (style default) or a hex color like "#101010"
GAUGE_DIAL_COLOR=auto
# Needle thickness multiplier for the classic/retro gauge designs (0.5 thin .. 3.0 thick)
NEEDLE_THICKNESS=1.0

