# Copy this file to .env and adjust values as needed.

# Processes to monitor: comma-separated names (partial match, case-insensitive)
# Example with multiple: PROCESS_NAMES=abt,hyperspace,bell
PROCESS_NAMES=abt

# Polling interval in seconds
POLL_INTERVAL=10

# GDI thresholds for traffic-light coloring
#   < WARN                → green
#   WARN  <= x < CRITICAL → yellow
#   >= CRITICAL           → red
GDI_WARN_THRESHOLD=100
GDI_CRITICAL_THRESHOLD=300

# Windows GDI object limit per process (used for the progress bar scale)
GDI_MAX=10000

# Desktop notifications when count reaches GDI_CRITICAL_THRESHOLD
NOTIFICATION_ENABLED=true
# Minimum seconds between notifications for the same PID (prevents spam)
NOTIFICATION_COOLDOWN=60

# Display options
SHOW_BAR=true
SHOW_PERCENTAGE=true
